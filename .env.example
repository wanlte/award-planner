# 复制成 .env 放在项目根目录即可生效（src/server.js 会自动读取）
# 线上（Sealos）不用这个文件，直接在应用管理里配环境变量

PORT=3210

# 填了才有登录页；留空则直接进应用（只适合本地开发）
APP_PASSWORD=test123

# ---------- 存储（三选一，按优先级自动判断）----------
# 1) 配了下面两行 → 用 Supabase（云端 Postgres），先执行 supabase/schema.sql
# 2) 不配 → 用本地 SQLite（data/planner.db，需要 Node 22+）
# 3) Node 低于 22 → 退回 JSON 文件（data/planner.json）

# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=粘贴 service_role key（不是 anon key，只在服务端用）

# 数据目录：只在用 SQLite / JSON 时有意义；本地默认 ./data，容器里指向存储卷 /data
PLANNER_DATA_DIR=./data
